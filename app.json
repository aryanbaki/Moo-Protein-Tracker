{
  "expo": {
    "name": "Moo",
    "slug": "moo-protein-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "moo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "owner": "aryanbakis-team",
    "extra": {
      "eas": {
        "projectId": "e3e7b8db-430f-4dc3-a5b5-deff3b0a45e1"
      }
    }
  }
}
