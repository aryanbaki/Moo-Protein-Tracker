{
  "expo": {
    "name": "Moo",
    "slug": "moo-protein-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "moo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Moo uses the camera to scan your food and barcodes.",
        "NSPhotoLibraryUsageDescription": "Moo lets you pick a food photo to analyse."
      },
      "usesAppleSignIn": true
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Moo uses the camera to scan your food and barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Moo lets you pick a food photo to analyse."
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "owner": "aryanbakis-team",
    "extra": {
      "eas": {
        "projectId": "e3e7b8db-430f-4dc3-a5b5-deff3b0a45e1"
      }
    }
  }
}
