{
  "expo": {
    "name": "Moo",
    "slug": "moo-protein-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "moo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
